{
  "$schema": "https://json.schemastore.org/prettierrc",
  "plugins": ["prettier-plugin-svelte"],
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "arrowParens": "always",
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.svelte",
      "options": { "parser": "svelte" }
    }
  ]
}
