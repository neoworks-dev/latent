{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://latent.local/protocol/messages.schema.json",
  "title": "LatentProtocol",
  "description": "JSON-RPC 2.0 methods between the Latent engine and its UI. Each method has <Method>Params and <Method>Result. Phase 0 surface only.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "_root": {
      "$ref": "#/definitions/Envelope"
    }
  },
  "definitions": {
    "Envelope": {
      "description": "JSON-RPC 2.0 envelope. `id` absent on notifications.",
      "type": "object",
      "required": [
        "jsonrpc"
      ],
      "properties": {
        "jsonrpc": {
          "const": "2.0"
        },
        "id": {
          "type": [
            "integer",
            "string"
          ]
        },
        "method": {
          "$ref": "#/definitions/MethodName"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "result": {},
        "error": {
          "$ref": "#/definitions/RpcError"
        }
      }
    },
    "RpcError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "data": {}
      }
    },
    "MethodName": {
      "type": "string",
      "enum": [
        "engine.hello",
        "ops.describe",
        "photo.open",
        "photo.close",
        "stack.get",
        "stack.set",
        "op.add",
        "op.update",
        "op.remove",
        "history.undo",
        "history.redo",
        "view.open",
        "view.close",
        "view.render",
        "python.run",
        "catalog.import",
        "catalog.list",
        "catalog.get",
        "catalog.folders",
        "catalog.setRating",
        "catalog.setFlag",
        "catalog.collections",
        "catalog.collectionSet",
        "catalog.thumbnail",
        "catalog.thumbnails",
        "catalog.remove",
        "job.cancel",
        "stack.changed",
        "engine.log",
        "catalog.changed",
        "job.progress",
        "python.output",
        "python.finished"
      ]
    },
    "NotificationName": {
      "description": "Engine → UI messages without an id. Calling one as a method is a -32601 error.",
      "type": "string",
      "enum": [
        "stack.changed",
        "engine.log",
        "catalog.changed",
        "job.progress",
        "python.output",
        "python.finished"
      ]
    },
    "PhotoId": {
      "description": "Stable catalog id (SQLite rowid), so an i64. LTHM binary frames carry it in a u32 slot (protocol/frames.md), which caps thumbnails at 4294967295: catalog.thumbnail and catalog.thumbnails answer -32602 for a larger id instead of sending a frame with a truncated target. Every other method takes the full range.",
      "type": "integer",
      "minimum": 1
    },
    "ViewId": {
      "type": "integer",
      "minimum": 1
    },
    "OpId": {
      "type": "string",
      "minLength": 1
    },
    "Op": {
      "description": "One entry of the op-stack. `op` names a definition from ops.describe; `params` validates against that definition's schema.",
      "type": "object",
      "required": [
        "id",
        "op",
        "params",
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/OpId"
        },
        "op": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "mask": {
          "$ref": "#/definitions/MaskRef"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "MaskRef": {
      "description": "Phase 1. Reserved so Op's shape does not change when masks arrive.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string"
        }
      }
    },
    "Stack": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Op"
      }
    },
    "OpParamSpec": {
      "description": "One slider/control of an op, in Lightroom terms.",
      "type": "object",
      "required": [
        "name",
        "type",
        "default"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "number",
            "integer",
            "boolean",
            "enum",
            "curve"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "default": {},
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "display": {
          "$ref": "#/definitions/OpParamDisplay"
        }
      }
    },
    "OpParamDisplay": {
      "description": "How a generated panel should draw this param. Advisory: a UI that ignores it still renders a correct control from `type`, `min`, `max` and `step`.",
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "`slider` is the default control. `kelvin` is a white-balance temperature slider, `curve` a tone-curve editor, `hsl` an eight-band colour mixer, `toggle` a checkbox.",
          "enum": [
            "slider",
            "kelvin",
            "curve",
            "hsl",
            "toggle"
          ]
        },
        "tint": {
          "type": "string",
          "description": "Gradient to paint under the track, the way Lightroom tints Temp blue→yellow and Tint green→magenta.",
          "enum": [
            "temperature",
            "tint",
            "hue",
            "saturation"
          ]
        }
      }
    },
    "OpDefinition": {
      "type": "object",
      "required": [
        "name",
        "panel",
        "label",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "section": {
          "type": "string",
          "description": "Lightroom's Edit-panel section this op is drawn in. The display name of `panel`, and the heading a generated panel groups under.",
          "enum": [
            "Light",
            "Color",
            "Effects",
            "Detail",
            "Optics",
            "Geometry"
          ]
        },
        "order": {
          "type": "integer",
          "description": "Position inside `section`, ascending, following Lightroom's slider order. Ops without one sort last, then by name."
        },
        "panel": {
          "type": "string",
          "enum": [
            "light",
            "color",
            "effects",
            "detail",
            "optics",
            "geometry",
            "generative"
          ]
        },
        "label": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpParamSpec"
          }
        }
      }
    },
    "Histogram": {
      "type": "object",
      "required": [
        "bins",
        "r",
        "g",
        "b",
        "clippedShadowsPct",
        "clippedHighlightsPct"
      ],
      "properties": {
        "bins": {
          "type": "integer"
        },
        "r": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "g": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "b": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "clippedShadowsPct": {
          "type": "number"
        },
        "clippedHighlightsPct": {
          "type": "number"
        }
      }
    },
    "EngineHelloParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "client": {
          "type": "string"
        }
      }
    },
    "EngineHelloResult": {
      "type": "object",
      "required": [
        "engineVersion",
        "protocolVersion",
        "gpu",
        "catalogPath"
      ],
      "properties": {
        "engineVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer"
        },
        "catalogPath": {
          "type": "string",
          "description": "Absolute path of the SQLite catalog this daemon opened. A UI shows which catalog it is on; a test asserts it is the throwaway one and not ~/.local/share/latent/catalog.db."
        },
        "mcpUrl": {
          "type": "string",
          "description": "Streamable-HTTP endpoint of the engine's MCP server, e.g. http://127.0.0.1:7801/mcp. Absent when the daemon was started with --no-mcp or the SDK failed to load."
        },
        "gpu": {
          "type": "object",
          "required": [
            "adapter",
            "maxTextureDimension2D",
            "shaderF16"
          ],
          "properties": {
            "adapter": {
              "type": "string"
            },
            "maxTextureDimension2D": {
              "type": "integer"
            },
            "shaderF16": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "OpsDescribeParams": {
      "type": "object",
      "additionalProperties": false
    },
    "OpsDescribeResult": {
      "type": "object",
      "required": [
        "ops"
      ],
      "properties": {
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OpDefinition"
          }
        }
      }
    },
    "PhotoOpenParams": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        }
      }
    },
    "PhotoOpenResult": {
      "description": "Opening a file catalogs it, so `catalog` carries the row and a client never has to follow photo.open with catalog.get. It is absent only when the engine opened a file it did not catalog.",
      "type": "object",
      "required": [
        "photoId",
        "width",
        "height",
        "camera",
        "hash",
        "sidecarLoaded"
      ],
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "camera": {
          "type": "string"
        },
        "hash": {
          "type": "string",
          "description": "SHA-256 hex of the raw file, as stored in the sidecar."
        },
        "sidecarLoaded": {
          "type": "boolean",
          "description": "True when an existing .latent sidecar was read and its stack restored."
        },
        "catalog": {
          "$ref": "#/definitions/CatalogPhoto"
        }
      }
    },
    "PhotoCloseParams": {
      "type": "object",
      "required": [
        "photoId"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        }
      }
    },
    "PhotoCloseResult": {
      "type": "object",
      "additionalProperties": false
    },
    "StackGetParams": {
      "type": "object",
      "required": [
        "photoId"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        }
      }
    },
    "StackGetResult": {
      "type": "object",
      "required": [
        "stack",
        "revision",
        "canUndo",
        "canRedo"
      ],
      "properties": {
        "stack": {
          "$ref": "#/definitions/Stack"
        },
        "revision": {
          "type": "integer"
        },
        "canUndo": {
          "type": "boolean"
        },
        "canRedo": {
          "type": "boolean"
        },
        "histogram": {
          "$ref": "#/definitions/Histogram"
        }
      }
    },
    "StackSetParams": {
      "type": "object",
      "required": [
        "photoId",
        "stack"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "stack": {
          "$ref": "#/definitions/Stack"
        }
      }
    },
    "StackSetResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "OpAddParams": {
      "type": "object",
      "required": [
        "photoId",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "op": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Omitted keys take the registry defaults; omitted entirely adds the op at defaults."
        },
        "index": {
          "type": "integer",
          "description": "Insert position; end of stack when omitted."
        },
        "transient": {
          "type": "boolean",
          "description": "True when the add is the first tick of a slider drag: no history snapshot, no sidecar write, so the whole drag undoes as one step. The first non-transient update after it snapshots."
        }
      }
    },
    "OpAddResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "OpUpdateParams": {
      "type": "object",
      "required": [
        "photoId",
        "opId",
        "params"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "opId": {
          "$ref": "#/definitions/OpId"
        },
        "params": {
          "type": "object",
          "additionalProperties": true,
          "description": "Partial; merged into the op's params."
        },
        "enabled": {
          "type": "boolean"
        },
        "transient": {
          "type": "boolean",
          "description": "True while a slider is being dragged: no history snapshot, no sidecar write. The first non-transient update after a drag snapshots."
        }
      }
    },
    "OpUpdateResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "OpRemoveParams": {
      "type": "object",
      "required": [
        "photoId",
        "opId"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "opId": {
          "$ref": "#/definitions/OpId"
        }
      }
    },
    "OpRemoveResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "HistoryUndoParams": {
      "$ref": "#/definitions/StackGetParams"
    },
    "HistoryUndoResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "HistoryRedoParams": {
      "$ref": "#/definitions/StackGetParams"
    },
    "HistoryRedoResult": {
      "$ref": "#/definitions/StackGetResult"
    },
    "ViewOpenParams": {
      "description": "A view is one canvas showing one photo at one proxy size. Frames for it arrive as LFRM binary frames tagged with viewId.",
      "type": "object",
      "required": [
        "photoId",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "photoId": {
          "$ref": "#/definitions/PhotoId"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ViewOpenResult": {
      "type": "object",
      "required": [
        "viewId"
      ],
      "properties": {
        "viewId": {
          "$ref": "#/definitions/ViewId"
        }
      }
    },
    "ViewCloseParams": {
      "type": "object",
      "required": [
        "viewId"
      ],
      "additionalProperties": false,
      "properties": {
        "viewId": {
          "$ref": "#/definitions/ViewId"
        }
      }
    },
    "ViewCloseResult": {
      "type": "object",
      "additionalProperties": false
    },
    "ViewRenderParams": {
      "description": "Ask for a frame of the view's current state. Resizing happens here too.",
      "type": "object",
      "required": [
        "viewId"
      ],
      "additionalProperties": false,
      "properties": {
        "viewId": {
          "$ref": "#/definitions/ViewId"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "ViewRenderResult": {
      "type": "object",
      "required": [
        "seq",
        "width",
        "height",
        "renderMs",
        "readbackMs",
        "revision"
      ],
      "properties": {
        "seq": {
          "type": "integer"
        },
        "revision": {
          "type": "integer",
          "description": "Stack revision the frame was rendered from — the same counter as StackGetResult.revision. A client that coalesced slider drags compares it with the revision of the last stack.changed it saw to know whether the frame it is holding is the newest state or one render behind."
        },
        "width": {
          "type": "integer",
          "description": "Size of the frame that was sent, so a client that dropped it still knows the view size."
        },
        "height": {
          "type": "integer"
        },
        "renderMs": {
          "type": "number"
        },
        "readbackMs": {
          "type": "number"
        }
      }
    },
    "PythonRunParams": {
      "type": "object",
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "photoId": {
          "$ref": "#/definitions/PhotoId",
          "description": "Bound to `latent.photo` for the run."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "default": 30000,
          "description": "Wall-clock budget for the script. On expiry the engine interrupts it with KeyboardInterrupt and answers with an error result (`ok: false`, the traceback in `stderr`), never by dropping the call. Default 30000."
        }
      }
    },
    "PythonRunResult": {
      "type": "object",
      "required": [
        "ok",
        "stdout",
        "stderr"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "durationMs": {
          "type": "number",
          "description": "Wall-clock time the script took, measured around the interpreter call. The same number the run's python.finished carries. Optional only so a client written against an older engine still typechecks; latentd and the mock always send it."
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "value": {
          "description": "repr() of the script's last expression, if any.",
          "type": "string"
        },
        "runId": {
          "$ref": "#/definitions/RunId",
          "description": "Set when the engine streamed the run's output as python.output notifications. `stdout`/`stderr` still carry the complete streams, so a client that showed the live output replaces it with these when the call returns."
        }
      }
    },
    "PythonOutputParams": {
      "description": "Notification: output a still-running script has produced. Sent to the socket that issued python.run, before that call's result. Long scripts stream; a short one may answer with the result alone.",
      "type": "object",
      "required": [
        "runId",
        "stream",
        "text"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/RunId"
        },
        "stream": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "text": {
          "type": "string",
          "description": "The chunk as written, newlines included. Never re-sent, never trimmed."
        }
      }
    },
    "PythonFinishedParams": {
      "description": "Notification: a run ended. Sent to the socket that issued python.run, after that run's last python.output and before the RPC result, so a console can close the output stream without waiting for the result to arrive.",
      "type": "object",
      "required": [
        "runId",
        "durationMs",
        "ok"
      ],
      "properties": {
        "runId": {
          "$ref": "#/definitions/RunId"
        },
        "durationMs": {
          "type": "number",
          "description": "Wall-clock time the script took. Matches the run's PythonRunResult.durationMs."
        },
        "ok": {
          "type": "boolean",
          "description": "False when the script raised or ran out of its timeoutMs budget; the traceback is in the result's stderr, not here."
        }
      }
    },
    "StackChangedParams": {
      "description": "Notification: the stack of a photo changed by any writer (UI, script, MCP). Carries the new state so the UI never re-fetches.",
      "allOf": [
        {
          "$ref": "#/definitions/StackGetResult"
        },
        {
          "type": "object",
          "required": [
            "photoId",
            "source"
          ],
          "properties": {
            "photoId": {
              "$ref": "#/definitions/PhotoId"
            },
            "source": {
              "type": "string",
              "description": "`ui` = the receiving client made this change itself; `external` = another socket did; `python`/`mcp` = a script or agent; `history` = undo/redo; `load` = sidecar restore on open.",
              "enum": [
                "ui",
                "external",
                "python",
                "mcp",
                "history",
                "load"
              ]
            },
            "client": {
              "type": "string",
              "description": "Who caused the change, one step more specific than `source` and free-form so it can name a tool: `ui`, `external`, `python`, `mcp:<tool>` (e.g. `mcp:run_python`), `history`, `load`. Per socket like `source` is — the writer sees `ui`, the others `external`. A console prints it; nothing branches on it."
            }
          }
        }
      ]
    },
    "EngineLogParams": {
      "type": "object",
      "required": [
        "level",
        "message"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "photoId": {
          "$ref": "#/definitions/PhotoId",
          "description": "Set when the message concerns one photo (e.g. a clamped op param)."
        }
      }
    },

    "PhotoFlag": {
      "type": "string",
      "enum": ["none", "pick", "reject"]
    },
    "CatalogPhoto": {
      "description": "One catalog row. `photoId` is the stable id used everywhere else.",
      "type": "object",
      "required": ["photoId", "path", "folder", "filename", "width", "height", "camera", "rating", "flag", "hasSidecar", "importedAt"],
      "properties": {
        "photoId": { "$ref": "#/definitions/PhotoId" },
        "path": { "type": "string" },
        "folder": { "type": "string", "description": "Absolute directory containing the file." },
        "filename": { "type": "string" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "camera": { "type": "string" },
        "lens": { "type": "string" },
        "capturedAt": { "type": "string", "description": "ISO 8601 from EXIF; absent when unknown." },
        "importedAt": { "type": "string", "description": "ISO 8601." },
        "editedAt": { "type": "string", "description": "ISO 8601 of the last non-transient stack change; absent when never edited." },
        "rating": { "type": "integer", "minimum": 0, "maximum": 5 },
        "flag": { "$ref": "#/definitions/PhotoFlag" },
        "hasSidecar": { "type": "boolean" },
        "hash": {
          "type": "string",
          "description": "SHA-256 hex of the raw file, the same value photo.open returns. Present once the engine has hashed the file — an import registers a row before hashing it, so a freshly imported row can lack it until it is opened."
        },
        "iso": { "type": "integer" },
        "shutter": { "type": "string", "description": "e.g. \"1/250\"" },
        "aperture": { "type": "number" },
        "focalLength": { "type": "number" }
      }
    },
    "CatalogCollection": {
      "type": "object",
      "required": ["collectionId", "name", "count"],
      "properties": {
        "collectionId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "count": { "type": "integer" }
      }
    },
    "JobId": { "type": "integer", "minimum": 1 },
    "RunId": {
      "description": "One python.run execution. Unique per engine process, so a client can tell its own run's output from another socket's.",
      "type": "integer",
      "minimum": 1
    },

    "CatalogImportParams": {
      "description": "Registers files (or every raw in the given directories) in the catalog and queues thumbnails. Returns immediately; progress arrives as job.progress notifications.",
      "type": "object",
      "required": ["paths"],
      "additionalProperties": false,
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "recursive": {
          "type": "boolean",
          "default": true,
          "description": "Descend into subdirectories. Default true; only directories in `paths` are affected."
        }
      }
    },
    "CatalogImportResult": {
      "type": "object",
      "required": ["jobId"],
      "properties": {
        "jobId": { "$ref": "#/definitions/JobId" },
        "thumbnailJobId": {
          "$ref": "#/definitions/JobId",
          "description": "The thumbnail job the import queues behind itself, reserved up front so a client can follow both from the one result. Its job.progress carries parentJobId = jobId. It always reports, even when the import found nothing or was cancelled — then with total 0. Absent from an engine that does not queue thumbnails."
        }
      }
    },
    "CatalogListParams": {
      "description": "Catalog rows, filtered and sorted. Every property narrows the result; combining them is an AND. Rows with equal sort keys are ordered by filename ascending, then by photoId ascending, so paging is stable and the same list never reshuffles between calls.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder": { "type": "string", "description": "Exact folder match; omit for every photo." },
        "photoIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/PhotoId" },
          "description": "Exactly these rows, in the list's sort order. Ids that are not in the catalog are left out rather than erroring. Useful for refreshing a selection without re-listing a page."
        },
        "query": {
          "type": "string",
          "description": "Case-insensitive substring match over filename and camera. Empty string matches everything."
        },
        "collectionId": { "type": "integer" },
        "flag": { "$ref": "#/definitions/PhotoFlag" },
        "minRating": { "type": "integer", "minimum": 0, "maximum": 5 },
        "sort": { "type": "string", "enum": ["capturedAt", "importedAt", "filename", "rating", "editedAt"] },
        "descending": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "CatalogListResult": {
      "type": "object",
      "required": ["photos", "total"],
      "properties": {
        "photos": { "type": "array", "items": { "$ref": "#/definitions/CatalogPhoto" } },
        "total": { "type": "integer", "description": "Matches before limit/offset." }
      }
    },
    "CatalogGetParams": {
      "type": "object",
      "required": ["photoId"],
      "additionalProperties": false,
      "properties": { "photoId": { "$ref": "#/definitions/PhotoId" } }
    },
    "CatalogGetResult": { "$ref": "#/definitions/CatalogPhoto" },
    "CatalogFoldersParams": { "type": "object", "additionalProperties": false },
    "CatalogFoldersResult": {
      "type": "object",
      "required": ["folders"],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "count"],
            "properties": { "path": { "type": "string" }, "count": { "type": "integer" } }
          }
        }
      }
    },
    "CatalogSetRatingParams": {
      "type": "object",
      "required": ["photoId", "rating"],
      "additionalProperties": false,
      "properties": {
        "photoId": { "$ref": "#/definitions/PhotoId" },
        "rating": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "CatalogSetRatingResult": { "$ref": "#/definitions/CatalogPhoto" },
    "CatalogSetFlagParams": {
      "type": "object",
      "required": ["photoId", "flag"],
      "additionalProperties": false,
      "properties": {
        "photoId": { "$ref": "#/definitions/PhotoId" },
        "flag": { "$ref": "#/definitions/PhotoFlag" }
      }
    },
    "CatalogSetFlagResult": { "$ref": "#/definitions/CatalogPhoto" },
    "CatalogCollectionsParams": { "type": "object", "additionalProperties": false },
    "CatalogCollectionsResult": {
      "type": "object",
      "required": ["collections"],
      "properties": {
        "collections": { "type": "array", "items": { "$ref": "#/definitions/CatalogCollection" } }
      }
    },
    "CatalogCollectionSetParams": {
      "description": "Create (name without collectionId), rename (both), add/remove members, or delete a collection.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collectionId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "add": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } },
        "remove": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } },
        "delete": { "type": "boolean" }
      }
    },
    "CatalogCollectionSetResult": { "$ref": "#/definitions/CatalogCollectionsResult" },
    "CatalogThumbnailParams": {
      "description": "Sends an LTHM binary frame (JPEG, target = photoId) before the result. Cached on disk by the engine; generated from the embedded preview when the raw has one, else from a fast half-size decode. A photoId above 4294967295 does not fit the frame's u32 target and is refused with -32602.",
      "type": "object",
      "required": ["photoId"],
      "additionalProperties": false,
      "properties": {
        "photoId": { "$ref": "#/definitions/PhotoId" },
        "size": { "type": "integer", "minimum": 32, "maximum": 2048, "description": "Long edge in px. Default 256." }
      }
    },
    "CatalogThumbnailResult": {
      "type": "object",
      "required": ["photoId", "width", "height"],
      "properties": {
        "photoId": { "$ref": "#/definitions/PhotoId" },
        "width": { "type": "integer" },
        "height": { "type": "integer" }
      }
    },
    "CatalogThumbnailsParams": {
      "description": "Batch form of catalog.thumbnail: one LTHM binary frame per photo that has one, all sent before the result. A filmstrip asks for the page it is about to draw in one call instead of one call per cell. An id above 4294967295 does not fit the frame's u32 target: the whole call is refused with -32602 rather than listed in `missing`, because it is a malformed request and not a photo that failed to render.",
      "type": "object",
      "required": ["photoIds"],
      "additionalProperties": false,
      "properties": {
        "photoIds": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } },
        "size": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048,
          "default": 256,
          "description": "Long edge in px, the same for every photo in the batch. Default 256."
        }
      }
    },
    "CatalogThumbnailsResult": {
      "description": "Sent after the frames. A photo that produced no thumbnail — unknown id, unreadable file, decode failure — is listed in `missing` and has no frame; the call itself does not fail.",
      "type": "object",
      "required": ["requested", "sent", "missing"],
      "properties": {
        "requested": { "type": "integer", "description": "photoIds after de-duplication." },
        "sent": { "type": "integer", "description": "Frames sent before this result." },
        "missing": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } }
      }
    },
    "CatalogRemoveParams": {
      "description": "Removes catalog rows: the database entries, their thumbnails and their collection memberships. Files on disk and their .latent sidecars are never touched — re-importing the same path brings the photo back (with a new photoId). Ids that are not in the catalog are ignored.",
      "type": "object",
      "required": ["photoIds"],
      "additionalProperties": false,
      "properties": {
        "photoIds": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } }
      }
    },
    "CatalogRemoveResult": {
      "type": "object",
      "required": ["removed"],
      "properties": {
        "removed": { "type": "integer", "description": "Rows actually deleted." }
      }
    },
    "JobCancelParams": {
      "description": "Asks a running job to stop at its next safe point. Work already done stands: a cancelled import keeps the photos it registered.",
      "type": "object",
      "required": ["jobId"],
      "additionalProperties": false,
      "properties": { "jobId": { "$ref": "#/definitions/JobId" } }
    },
    "JobCancelResult": {
      "type": "object",
      "required": ["cancelled"],
      "properties": {
        "cancelled": {
          "type": "boolean",
          "description": "True when a running job was asked to stop; false when the job is unknown or already finished. The job's last job.progress then has `finished: true` and `state: \"cancelled\"`."
        }
      }
    },
    "CatalogChangedParams": {
      "description": "Notification: catalog rows changed. Clients re-list what they show.",
      "type": "object",
      "required": ["photoIds", "reason"],
      "properties": {
        "photoIds": { "type": "array", "items": { "$ref": "#/definitions/PhotoId" } },
        "reason": { "type": "string", "enum": ["import", "rating", "flag", "collection", "edit", "remove"] }
      }
    },
    "JobProgressParams": {
      "description": "Notification for long-running engine work (import, thumbnails, later export).",
      "type": "object",
      "required": ["jobId", "kind", "done", "total", "finished"],
      "properties": {
        "jobId": { "$ref": "#/definitions/JobId" },
        "parentJobId": {
          "$ref": "#/definitions/JobId",
          "description": "The job that queued this one — set on the thumbnail job an import spawns, absent on a job nobody spawned. A progress UI nests the child under its parent instead of showing two unrelated bars."
        },
        "kind": { "type": "string", "enum": ["import", "thumbnails", "export"] },
        "done": { "type": "integer" },
        "total": { "type": "integer" },
        "finished": { "type": "boolean" },
        "state": {
          "type": "string",
          "enum": ["running", "done", "cancelled", "error"],
          "description": "How the job stands. `running` while `finished` is false; one of the other three on the last notification. Absent means `running` until finished, then `done` — so a client written before this field keeps working."
        },
        "message": { "type": "string" },
        "error": { "type": "string" }
      }
    }
  }
}
