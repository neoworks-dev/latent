{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["svelte", "bun"],
    "declaration": false,
    // svelte-check follows imports into the linked design-system source, which is not
    // ours to fix; the pure-TS packages keep noUncheckedIndexedAccess on.
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"]
}
