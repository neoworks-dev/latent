{
 "_fragment": {
  "name": "inpaint-sdxl",
  "description": "SDXL inpainting through InpaintModelConditioning: the graph that runs on a plain SD/SDXL checkpoint, with no Flux Fill weights to download. The mask port is typed MASK so the composer puts an ImageToMask behind its loader \u2014 Latent uploads an 8-bit grey PNG, not an image with an alpha channel. Rebuild with `comfy workflow compose`; never hand-edit the compiled graph.",
  "terminal": false,
  "source": "sdxl-source.json",
  "inputs": {
   "inpaintmodelconditioning_pixels": {
    "type": "IMAGE",
    "binds": "4.pixels"
   },
   "inpaintmodelconditioning_mask": {
    "type": "MASK",
    "binds": "4.mask"
   }
  },
  "outputs": {
   "image": {
    "type": "IMAGE",
    "from": "6",
    "port": 0
   }
  },
  "params": {
   "checkpointloadersimple_ckpt_name": {
    "type": "STRING",
    "binds": "1.ckpt_name",
    "default": "RealVisXL_V5.0_fp16.safetensors"
   },
   "cliptextencode_text": {
    "type": "STRING",
    "binds": "2.text",
    "default": "a photograph"
   },
   "cliptextencode_text_2": {
    "type": "STRING",
    "binds": "3.text",
    "default": "text, watermark, blurry, low quality"
   },
   "inpaintmodelconditioning_noise_mask": {
    "type": "BOOLEAN",
    "binds": "4.noise_mask",
    "default": true
   },
   "ksampler_seed": {
    "type": "INT",
    "binds": "5.seed",
    "default": 0
   },
   "ksampler_steps": {
    "type": "INT",
    "binds": "5.steps",
    "default": 25
   },
   "ksampler_cfg": {
    "type": "FLOAT",
    "binds": "5.cfg",
    "default": 7.0
   },
   "ksampler_sampler_name": {
    "type": "STRING",
    "binds": "5.sampler_name",
    "default": "dpmpp_2m"
   },
   "ksampler_scheduler": {
    "type": "STRING",
    "binds": "5.scheduler",
    "default": "karras"
   },
   "ksampler_denoise": {
    "type": "FLOAT",
    "binds": "5.denoise",
    "default": 1.0
   }
  }
 },
 "1": {
  "class_type": "CheckpointLoaderSimple",
  "inputs": {
   "ckpt_name": "RealVisXL_V5.0_fp16.safetensors"
  }
 },
 "2": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "a photograph",
   "clip": [
    "1",
    1
   ]
  }
 },
 "3": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": "text, watermark, blurry, low quality",
   "clip": [
    "1",
    1
   ]
  }
 },
 "4": {
  "class_type": "InpaintModelConditioning",
  "inputs": {
   "noise_mask": true,
   "positive": [
    "2",
    0
   ],
   "negative": [
    "3",
    0
   ],
   "vae": [
    "1",
    2
   ],
   "pixels": [
    "8",
    0
   ],
   "mask": [
    "9",
    1
   ]
  }
 },
 "5": {
  "class_type": "KSampler",
  "inputs": {
   "seed": 0,
   "steps": 25,
   "cfg": 7.0,
   "sampler_name": "dpmpp_2m",
   "scheduler": "karras",
   "denoise": 1.0,
   "model": [
    "1",
    0
   ],
   "positive": [
    "4",
    0
   ],
   "negative": [
    "4",
    1
   ],
   "latent_image": [
    "4",
    2
   ]
  }
 },
 "6": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "5",
    0
   ],
   "vae": [
    "1",
    2
   ]
  }
 }
}