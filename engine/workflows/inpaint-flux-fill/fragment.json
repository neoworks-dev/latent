{
 "_fragment": {
  "name": "inpaint-flux-fill",
  "description": "Flux.1 Fill Dev inpainting, decomposed from ComfyUI's flux_fill_inpaint_example template. The mask port is retyped MASK so the composer puts an ImageToMask behind its loader: Latent uploads an 8-bit grey PNG, not an image with an alpha channel. Rebuild with `comfy workflow compose`; never hand-edit the compiled graph.",
  "terminal": false,
  "source": "flux-template.json",
  "inputs": {
   "inpaintmodelconditioning_pixels": {
    "type": "IMAGE",
    "binds": "11.pixels"
   },
   "inpaintmodelconditioning_mask": {
    "type": "MASK",
    "binds": "11.mask"
   }
  },
  "outputs": {
   "image": {
    "type": "IMAGE",
    "from": "10",
    "port": 0
   }
  },
  "params": {
   "load_clip_dual_clip_name1": {
    "type": "STRING",
    "binds": "3.clip_name1",
    "default": "clip_l.safetensors"
   },
   "load_clip_dual_clip_name2": {
    "type": "STRING",
    "binds": "3.clip_name2",
    "default": "t5xxl_fp16.safetensors"
   },
   "load_clip_dual_type": {
    "type": "STRING",
    "binds": "3.type",
    "default": "flux"
   },
   "load_clip_dual_device": {
    "type": "STRING",
    "binds": "3.device",
    "default": "default"
   },
   "fluxguidance_guidance": {
    "type": "INT",
    "binds": "4.guidance",
    "default": 30
   },
   "load_vae_vae_name": {
    "type": "STRING",
    "binds": "5.vae_name",
    "default": "ae.safetensors"
   },
   "load_diffusion_model_unet_name": {
    "type": "STRING",
    "binds": "6.unet_name",
    "default": "flux1-fill-dev.safetensors"
   },
   "load_diffusion_model_weight_dtype": {
    "type": "STRING",
    "binds": "6.weight_dtype",
    "default": "default"
   },
   "clip_text_encode_positive_prompt_text": {
    "type": "STRING",
    "binds": "8.text",
    "default": "anime girl with massive fennec ears blonde hair blue eyes wearing a pink shirt"
   },
   "differential_diffusion_strength": {
    "type": "INT",
    "binds": "9.strength",
    "default": 1
   },
   "inpaintmodelconditioning_noise_mask": {
    "type": "BOOLEAN",
    "binds": "11.noise_mask",
    "default": true
   },
   "ksampler_seed": {
    "type": "INT",
    "binds": "12.seed",
    "default": 190664687740330
   },
   "ksampler_steps": {
    "type": "INT",
    "binds": "12.steps",
    "default": 20
   },
   "ksampler_cfg": {
    "type": "INT",
    "binds": "12.cfg",
    "default": 1
   },
   "ksampler_sampler_name": {
    "type": "STRING",
    "binds": "12.sampler_name",
    "default": "euler"
   },
   "ksampler_scheduler": {
    "type": "STRING",
    "binds": "12.scheduler",
    "default": "normal"
   },
   "ksampler_denoise": {
    "type": "INT",
    "binds": "12.denoise",
    "default": 1
   }
  }
 },
 "3": {
  "inputs": {
   "clip_name1": "clip_l.safetensors",
   "clip_name2": "t5xxl_fp16.safetensors",
