{
  "_fragment": {
    "name": "denoise-sdxl",
    "description": "Denoise as an img2img pass: the frame is encoded to latent and resampled at a low denoise, which is what removes sensor noise without a dedicated restoration model. ComfyUI ships no SCUNet/Restormer node, so this is the honest local stand-in — a real denoiser belongs in the raw domain, before demosaic (issue #51). The engine substitutes the sampler's denoise from the op's Strength. Rebuild with `comfy workflow compose`; never hand-edit the compiled graph.",
    "terminal": false,
    "inputs": {
      "vaeencode_pixels": {
        "type": "IMAGE",
        "binds": "4.pixels"
      }
    },
    "outputs": {
      "image": {
        "type": "IMAGE",
        "from": "6",
        "port": 0
      }
    },
    "params": {
      "checkpointloadersimple_ckpt_name": {
        "type": "STRING",
        "binds": "1.ckpt_name",
        "default": "RealVisXL_V5.0_fp16.safetensors"
      },
      "cliptextencode_text": {
        "type": "STRING",
        "binds": "2.text",
        "default": "a clean photograph, fine natural detail, sharp grain-free texture"
      },
      "cliptextencode_text_2": {
        "type": "STRING",
        "binds": "3.text",
        "default": "noise, grain, chroma noise, speckle, banding, smudged detail, artifacts"
      },
      "ksampler_seed": {
        "type": "INT",
        "binds": "5.seed",
        "default": 0
      },
      "ksampler_steps": {
        "type": "INT",
        "binds": "5.steps",
        "default": 20
      },
      "ksampler_cfg": {
        "type": "FLOAT",
        "binds": "5.cfg",
        "default": 3.0
      },
      "ksampler_sampler_name": {
        "type": "STRING",
        "binds": "5.sampler_name",
        "default": "dpmpp_2m"
      },
      "ksampler_scheduler": {
        "type": "STRING",
        "binds": "5.scheduler",
        "default": "karras"
      },
      "ksampler_denoise": {
        "type": "FLOAT",
        "binds": "5.denoise",
        "default": 0.3
      }
    }
  },
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "RealVisXL_V5.0_fp16.safetensors" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "a clean photograph, fine natural detail, sharp grain-free texture",
      "clip": ["1", 1]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "noise, grain, chroma noise, speckle, banding, smudged detail, artifacts",
      "clip": ["1", 1]
    }
  },
  "4": {
    "class_type": "VAEEncode",
    "inputs": { "vae": ["1", 2] }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 3.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.3,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0]
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
  }
}
