{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "latent-engine",
  "version-string": "0.0.0",
  "description": "Latent raw photo engine daemon",
  "dependencies": [
    "libraw",
    "nlohmann-json",
    "uwebsockets",
    "libpng",
    "libjpeg-turbo",
    "sqlite3",
    "catch2",
    "pybind11",
    "tiff",
    "lcms",
    { "name": "libavif", "features": ["aom"] }
  ]
}
